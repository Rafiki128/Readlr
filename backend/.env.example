PORT=3000
GROQ_API_KEY=your_groq_api_key_here

# Local development can use SQLite without Supabase credentials.
# The generated database file is ignored by git.
DATABASE_PROVIDER=sqlite
DATABASE_PATH=readlr.db

# Use these with DATABASE_PROVIDER=supabase for hosted persistence.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
JWT_SECRET=generate_a_long_random_value
NODE_ENV=production
# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGIN=https://app.yourdomain.com
